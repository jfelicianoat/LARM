<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Manifiesto de larm-daemon (P011). Sin la declaración de compatibilidad,
  Windows aplica el «version lie» a los procesos no manifestados: las
  versiones con prefijo de sistema (10.0.x) se leen como 6.2.x, y la versión
  de fichero de DLL como amdhip64_6.dll quedaba falseada en el perfil.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 y Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
