{
  "$defs": {
    "larm__CapabilityRequest": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "minLength": 1,
          "type": "string"
        },
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/larm__Generation"
            },
            {
              "type": "null"
            }
          ]
        },
        "input": {
          "type": "object"
        },
        "lease_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "stream": {
          "type": "boolean"
        }
      },
      "required": [
        "lease_id",
        "request_id",
        "capability",
        "input",
        "generation",
        "stream"
      ],
      "type": "object"
    },
    "larm__Generation": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "top_p": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "temperature",
        "top_p",
        "seed",
        "max_output_tokens"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/larm__CapabilityRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
