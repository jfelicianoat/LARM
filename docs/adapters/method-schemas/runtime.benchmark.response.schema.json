{
  "$defs": {
    "larm__BenchmarkOutput": {
      "additionalProperties": false,
      "properties": {
        "artifact_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "benchmark_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "fingerprint": {
          "$ref": "#/$defs/larm__Fingerprint"
        },
        "fixture_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "metrics": {
          "type": "object"
        },
        "raw_samples": {
          "items": {
            "$ref": "#/$defs/larm__RawBenchmarkSample"
          },
          "type": "array"
        },
        "settings_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "BLOCKED_REAL"
          ],
          "type": "string"
        },
        "suite_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "benchmark_id",
        "fingerprint",
        "suite_hash",
        "fixture_hash",
        "settings_hash",
        "raw_samples",
        "artifact_refs",
        "metrics",
        "status"
      ],
      "type": "object"
    },
    "larm__EvidenceComponent": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "VERIFIED",
            "DECLARED",
            "UNAVAILABLE"
          ],
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "status",
        "evidence_refs"
      ],
      "type": "object"
    },
    "larm__Fingerprint": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "additionalProperties": {
            "$ref": "#/$defs/larm__EvidenceComponent"
          },
          "minProperties": 1,
          "type": "object"
        },
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "hash",
        "components"
      ],
      "type": "object"
    },
    "larm__RawBenchmarkSample": {
      "additionalProperties": false,
      "properties": {
        "backend_effective": {
          "minLength": 1,
          "type": "string"
        },
        "end_monotonic_ns": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string",
          "x-maximum-decimal": "9223372036854775807"
        },
        "error": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation_duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "iteration": {
          "minimum": 0,
          "type": "integer"
        },
        "load_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "peak_ram_bytes": {
          "anyOf": [
            {
              "maxLength": 19,
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string",
              "x-maximum-decimal": "9223372036854775807"
            },
            {
              "type": "null"
            }
          ]
        },
        "peak_vram_bytes": {
          "anyOf": [
            {
              "maxLength": 19,
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string",
              "x-maximum-decimal": "9223372036854775807"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_monotonic_ns": {
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string",
          "x-maximum-decimal": "9223372036854775807"
        },
        "success": {
          "type": "boolean"
        },
        "ttft_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "warmup": {
          "type": "boolean"
        }
      },
      "required": [
        "iteration",
        "warmup",
        "start_monotonic_ns",
        "end_monotonic_ns",
        "load_ms",
        "ttft_ms",
        "input_tokens",
        "output_tokens",
        "generation_duration_ms",
        "peak_ram_bytes",
        "peak_vram_bytes",
        "backend_effective",
        "success",
        "error"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/larm__BenchmarkOutput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
