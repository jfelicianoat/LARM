{
  "$defs": {
    "larm__ArtifactManifest": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "relative_path": {
                "minLength": 1,
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "role": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "size_bytes": {
                "anyOf": [
                  {
                    "maxLength": 19,
                    "pattern": "^(0|[1-9][0-9]*)$",
                    "type": "string",
                    "x-maximum-decimal": "9223372036854775807"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "size_estimate": {
                "$ref": "#/$defs/larm__ArtifactSizeEstimate"
              }
            },
            "required": [
              "relative_path",
              "size_bytes",
              "sha256",
              "required",
              "role"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "manifest_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "revision_key": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "revision_key",
        "manifest_hash",
        "artifacts"
      ],
      "type": "object"
    },
    "larm__ArtifactSizeEstimate": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "confidence": {
                "const": "EXACT"
              }
            },
            "required": [
              "confidence"
            ]
          },
          "then": {
            "properties": {
              "bytes": {
                "maxLength": 19,
                "pattern": "^(0|[1-9][0-9]*)$",
                "type": "string",
                "x-maximum-decimal": "9223372036854775807"
              },
              "lower_bound_bytes": {
                "maxLength": 19,
                "pattern": "^(0|[1-9][0-9]*)$",
                "type": "string",
                "x-maximum-decimal": "9223372036854775807"
              },
              "source": {
                "const": "MANIFEST"
              },
              "upper_bound_bytes": {
                "maxLength": 19,
                "pattern": "^(0|[1-9][0-9]*)$",
                "type": "string",
                "x-maximum-decimal": "9223372036854775807"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confidence": {
                "const": "HIGH"
              }
            },
            "required": [
              "confidence"
            ]
          },
          "then": {
            "properties": {
              "bytes": {
                "maxLength": 19,
                "pattern": "^(0|[1-9][0-9]*)$",
                "type": "string",
                "x-maximum-decimal": "9223372036854775807"
              },
              "lower_bound_bytes": {
                "type": "null"
              },
              "source": {
                "enum": [
                  "CONTENT_LENGTH",
                  "GIT_LFS_METADATA",
                  "HTTP_HEAD",
                  "SOURCE_METADATA"
                ]
              },
              "upper_bound_bytes": {
                "maxLength": 19,
                "pattern": "^(0|[1-9][0-9]*)$",
                "type": "string",
                "x-maximum-decimal": "9223372036854775807"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confidence": {
                "const": "ESTIMATED"
              }
            },
            "required": [
              "confidence"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "bytes": {
                    "maxLength": 19,
                    "pattern": "^(0|[1-9][0-9]*)$",
                    "type": "string",
                    "x-maximum-decimal": "9223372036854775807"
                  },
                  "lower_bound_bytes": {
                    "type": "null"
                  },
                  "upper_bound_bytes": {
                    "maxLength": 19,
                    "pattern": "^(0|[1-9][0-9]*)$",
                    "type": "string",
                    "x-maximum-decimal": "9223372036854775807"
                  }
                }
              },
              {
                "properties": {
                  "bytes": {
                    "type": "null"
                  },
                  "lower_bound_bytes": {
                    "maxLength": 19,
                    "pattern": "^(0|[1-9][0-9]*)$",
                    "type": "string",
                    "x-maximum-decimal": "9223372036854775807"
                  },
                  "upper_bound_bytes": {
                    "maxLength": 19,
                    "pattern": "^(0|[1-9][0-9]*)$",
                    "type": "string",
                    "x-maximum-decimal": "9223372036854775807"
                  }
                }
              }
            ],
            "properties": {
              "source": {
                "not": {
                  "const": "UNKNOWN"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confidence": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "confidence"
            ]
          },
          "then": {
            "properties": {
              "bytes": {
                "type": "null"
              },
              "lower_bound_bytes": {
                "type": "null"
              },
              "reason": {
                "minLength": 1,
                "type": "string"
              },
              "source": {
                "const": "UNKNOWN"
              },
              "upper_bound_bytes": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "maxLength": 19,
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string",
              "x-maximum-decimal": "9223372036854775807"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "enum": [
            "EXACT",
            "HIGH",
            "ESTIMATED",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "lower_bound_bytes": {
          "anyOf": [
            {
              "maxLength": 19,
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string",
              "x-maximum-decimal": "9223372036854775807"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "MANIFEST",
            "CONTENT_LENGTH",
            "GIT_LFS_METADATA",
            "HTTP_HEAD",
            "SOURCE_METADATA",
            "USER_DECLARED",
            "LOCAL_OBSERVATION",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "upper_bound_bytes": {
          "anyOf": [
            {
              "maxLength": 19,
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string",
              "x-maximum-decimal": "9223372036854775807"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "confidence",
        "bytes",
        "lower_bound_bytes",
        "upper_bound_bytes",
        "source",
        "evidence_refs",
        "reason"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/larm__ArtifactManifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
