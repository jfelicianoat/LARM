{
  "$defs": {
    "larm__SourceDownloadChunk": {
      "additionalProperties": false,
      "properties": {
        "data_base64": {
          "maxLength": 699052,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "type": "string"
        },
        "eof": {
          "type": "boolean"
        },
        "offset": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "total_bytes": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "validator": {
          "anyOf": [
            {
              "$ref": "#/$defs/larm__SourceDownloadResumeValidator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "offset",
        "data_base64",
        "eof",
        "total_bytes",
        "validator"
      ],
      "type": "object"
    },
    "larm__SourceDownloadResumeValidator": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "STRONG_ETAG"
            },
            "value": {
              "maxLength": 1024,
              "minLength": 2,
              "pattern": "^\"[!#-~]*\"$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "LAST_MODIFIED_AND_SHA256"
            },
            "last_modified": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "last_modified",
            "sha256"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$ref": "#/$defs/larm__SourceDownloadChunk",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
