{
  "$defs": {
    "larm__JobReceipt": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "state": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "CANCELLED"
          ],
          "type": "string"
        },
        "status_url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "status_url",
        "state"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/larm__JobReceipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
