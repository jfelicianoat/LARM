{
  "$id": "https://larm.local/adapters/frame.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "jsonrpc": {
      "const": "2.0"
    },
    "method": {
      "minLength": 1,
      "type": "string"
    },
    "params": {}
  },
  "required": [
    "jsonrpc",
    "id",
    "method"
  ],
  "type": "object"
}
