{
  "$id": "https://larm.local/adapters/frame.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "not": {
        "required": [
          "error"
        ]
      },
      "required": [
        "result"
      ]
    },
    {
      "not": {
        "required": [
          "result"
        ]
      },
      "required": [
        "error"
      ]
    }
  ],
  "properties": {
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            -32700,
            -32600,
            -32601,
            -32602,
            -32000
          ],
          "type": "integer"
        },
        "data": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "minLength": 1,
              "type": "string"
            },
            "correlation_id": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "details": {
              "additionalProperties": false,
              "properties": {
                "evidence_refs": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "original_error": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "code": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "message": {
                          "maxLength": 4096,
                          "type": "string"
                        },
                        "system": {
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "system",
                        "code",
                        "message"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "minLength": 1,
                  "type": "string"
                },
                "resource_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "reason",
                "evidence_refs",
                "resource_ids",
                "original_error"
              ],
              "type": "object"
            },
            "message": {
              "minLength": 1,
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "correlation_id",
            "details"
          ],
          "type": "object"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "jsonrpc": {
      "const": "2.0"
    },
    "result": {}
  },
  "required": [
    "jsonrpc",
    "id"
  ],
  "type": "object"
}
